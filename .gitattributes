# 统一换行符：仓库内一律 LF；Windows 批处理脚本保持 CRLF
* text=auto eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二进制文件不做换行符转换，也不做文本差异
*.exe    binary
*.dll    binary
*.lib    binary
*.obj    binary
*.pdb    binary
*.ilk    binary
*.exp    binary
*.ico    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ttf    binary
*.ttc    binary
*.otf    binary
*.gz     binary
*.7z     binary
*.zip    binary

# 生成的锁文件不参与 diff 统计（仍正常入库）
package-lock.json -diff
